# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# UI 文案是 UTF-8;应用自带的点阵字体子集也依赖 UTF-8 解码,故显式打开该选项。
CONFIG_LV_TXT_ENC_UTF8=y
# LVGL 内置 malloc 池大小(KB)。它是独立静态区、不与系统堆共享。本应用两张屏幕
# 约 65 个控件、并给部分控件设置局部样式,24KB 偏紧;32KB 比 24KB 多占 8KB 静态
# RAM(本板无 PSRAM,这个代价必须明确),换取更稳的刷新与足够的样式开销。
CONFIG_LV_MEM_SIZE_KILOBYTES=32

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- Bluetooth LE / NimBLE ---
# ESP32-C3 仅支持 BLE。应用同时需要两种角色:
#   * observer(ROLE_OBSERVER):扫描周围设备(main/ble_scan.c);
#   * central(ROLE_CENTRAL):用户长按详情页时主动连接并只读 GATT 信息
#     (main/ble_client.c,支持 NOVA / SEEKER)。
# 本应用不广播、不提供 GATT 服务,所以 peripheral / broadcaster 关闭;一次只连接
# 一台被读取设备,MAX_CONNECTIONS=1 足够。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# ATT 首选 MTU 256:只读请求(SEEKER 的 JSON / NOVA 的 32B 私钥)都能一次写完,
# 也保证 notify 单包能装下 SEEKER 的 22B 头 + 正文。
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n
# 只读会话不做 BLE 层配对/加密:NOVA 是应用层 0x07/0x08 认证,SEEKER 是 JSON
# token;SMP 用不到,关闭可省 Flash/RAM(该设置在只扫描阶段已验证可链接,加入
# central 后继续保留)。
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
